{
  "name": "legado-source-protocol-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "validate": "node cli.mjs",
